# Copy this file to .env.local for local dev, and also add this value in
# Vercel's Project Settings -> Environment Variables for production.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional -- only set this if the default model stops working. New
# Gemini API keys get redirected to a different "latest lite" model every
# so often; check https://ai.google.dev/gemini-api/docs/models or run:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY"
# to see what your key can currently use.
# GEMINI_MODEL=gemini-3.5-flash-lite
